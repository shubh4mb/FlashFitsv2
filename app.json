{
  "expo": {
    "name": "FlashFits",
    "slug": "FlashFits",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flashfits",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.flashfits.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        },
        "NSLocationWhenInUseUsageDescription": "Allow FlashFits to use your location to show nearby stores, fast delivery options, and 30-minute Try at Home service.",
        "NSPhotoLibraryUsageDescription": "Allow FlashFits to access your photo library to upload return proofs or product reviews.",
        "NSCameraUsageDescription": "Allow FlashFits to take photos of items for returns or reviews.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "upi",
          "tez",
          "phonepe",
          "paytmmp",
          "bhim",
          "credpay",
          "whatsapp"
        ]
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#3CDCF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.flashfits.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#3CDCF4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FlashFits to use your location for delivery services.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FlashFits to access your photos for returns and reviews.",
          "cameraPermission": "Allow FlashFits to take photos for returns and reviews."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3CDCF4"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/favicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.38756562066-lgbnn9g7auuacav4mj59277p34ojc9f3"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.google.android.gms.** { *; }\n-dontwarn com.google.android.gms.**\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      // "BACKEND_URL": "https://api.theflashfits.com",
      // "BACKEND_URL":"http://192.168.29.230:5000",
      "BACKEND_URL":"https://8d43-2405-201-f001-8ff-670a-486b-b150-a8ac.ngrok-free.app",
      "router": {},
      "eas": {
        "projectId": "5ffa6730-d676-4b63-a03d-df1db41ca12b"
      }
    },
    "owner": "efron"
  }
}
